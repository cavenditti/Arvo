{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.arvo.farm",
        "EXPO_PUBLIC_AUTH_URL": "https://app.arvo.farm"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6797212459"
      }
    }
  }
}
