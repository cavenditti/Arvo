{
  "expo": {
    "name": "Arvo",
    "slug": "arvo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arvo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "farm.arvo.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Arvo uses your location and facing direction to find the field in front of you and attach scouting notes to the right place.",
        "NSCameraUsageDescription": "Arvo uses the camera to photograph fields and plants, suggest the crop with AI, and document scouting notes.",
        "NSPhotoLibraryUsageDescription": "Arvo accesses only the photos you choose so it can suggest the crop with AI or attach them to scouting notes.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSFaceIDUsageDescription": "Arvo uses Face ID only to unlock the app."
      }
    },
    "locales": {
      "it": "./locales/it.json"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F1EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F1EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#101410",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-system-ui",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32b2ff14-cf07-4a95-990c-bbe6315e1ce8"
      }
    },
    "owner": "cavenditti"
  }
}
